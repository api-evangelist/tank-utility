      "item": [
        {
          "id": "13d8aef2-c146-4fc6-a27f-67ba209ad238",
          "name": "Get an API token",
          "request": {
            "name": "Get an API token",
            "description": {
              "content": "Authenticate with HTTP Basic (account email as username, account password) and receive a short-lived API token. The token is valid for approximately 24 hours and is passed as the `token` query parameter to all other operations.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "getToken"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
